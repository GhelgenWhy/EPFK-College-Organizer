generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Group {
  id        Int        @id @default(autoincrement())
  groupName String     @unique @map("group_name") @db.Text
  users     User[]
  schedules Schedule[]

  @@map("group")
}

model Status {
  id         Int    @id @default(autoincrement())
  statusName String @map("status_name") @db.Text
  users      User[]

  @@map("status")
}

model User {
  id          Int               @id @default(autoincrement())
  userName    String            @map("user_name") @db.Text
  userSurname String            @map("user_surname") @db.Text
  token       String?           @db.Text
  email       String            @unique @db.Text
  password    String            @db.Text
  groupId     Int?              @map("group_id")
  statusId    Int?              @map("status_id")
  lastSync    DateTime?         @map("last_sync") @db.Timestamptz(3)
  group       Group?            @relation(fields: [groupId], references: [id])
  status      Status?           @relation(fields: [statusId], references: [id])
  disciplines UsersDiscipline[]
  tasks       UsersTask[]

  @@index([groupId])
  @@index([statusId])
  @@map("user")
}

model Discipline {
  id             Int               @id @default(autoincrement())
  moodleId       Int               @unique @map("moodle_id")
  disciplineName String            @map("discipline_name") @db.Text
  teacher        String            @db.Text
  tasks          Task[]
  users          UsersDiscipline[]

  @@map("discipline")
}

model Task {
  id           Int         @id @default(autoincrement())
  moodleId     Int         @unique @map("moodle_id")
  taskName     String      @map("task_name") @db.Text
  deadline     DateTime?   @db.Timestamptz(3)
  description  String?     @db.Text
  addedAt      DateTime    @default(now()) @map("added_at") @db.Timestamptz(3)
  disciplineId Int         @map("discipline_id")
  discipline   Discipline  @relation(fields: [disciplineId], references: [id])
  users        UsersTask[]

  @@index([disciplineId])
  @@map("task")
}

model UsersDiscipline {
  id           Int        @id @default(autoincrement())
  userId       Int        @map("user_id")
  disciplineId Int        @map("discipline_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@unique([userId, disciplineId])
  @@index([disciplineId])
  @@map("users_disciplines")
}

model UsersTask {
  id          Int     @id @default(autoincrement())
  userId      Int     @map("user_id")
  taskId      Int     @map("task_id")
  isCompleted Boolean @default(false) @map("is_completed")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([taskId])
  @@map("users_tasks")
}

/// Lesson lists are stored separately in a file named after this schedule's id.
model Schedule {
  id      Int   @id @default(autoincrement())
  groupId Int   @map("group_id")
  group   Group @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@map("schedule")
}

model Event {
  id          Int      @id @default(autoincrement())
  owner       String   @db.Text
  eventName   String   @map("event_name") @db.Text
  startTime   DateTime @map("start_time") @db.Timestamptz(3)
  place       String?  @db.Text
  description String?  @db.Text

  @@map("event")
}
